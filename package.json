{
  "name": "sendtexttodots",
  "version": "0.3.0",
  "private": true,
  "description": "Self-hosted API and MCP Events/OAuth service that delivers text from an authenticated source to the owner's subscribed Dots destination (Google Cloud Functions + Cloud Run, Firestore, Cloud KMS, Secret Manager, Firebase Authentication with Sign in with Apple).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.2.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node scripts/run-tests.mjs",
    "package": "node scripts/package-artifacts.mjs package",
    "console": "node dist/console/local-server.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "8.3.0",
    "@google-cloud/kms": "6.3.0",
    "@google-cloud/secret-manager": "7.2.0",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "google-gax": "6.5.0",
    "oidc-provider": "9.12.2",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/oidc-provider": "9.12.1",
    "typescript": "7.0.2"
  }
}
